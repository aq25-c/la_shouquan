# ===== 服务端基础 =====
# 监听端口 / 地址
PORT=6889
HOST=0.0.0.0

# 数据目录（SQLite 库、签名密钥都在这里，务必挂载持久卷）
DATA_DIR=/data
# 也可以显式指定数据库文件路径（优先级高于 DATA_DIR）
# DB_PATH=/data/license.db

# ===== 初始管理员（首次启动时自动创建，已存在则忽略）=====
# 生产环境务必改成强密码，并建议在首次登录后修改
ADMIN_EMAIL=tudoudashi7789@outlook.com
ADMIN_PASSWORD=lishuai123.
ADMIN_NAME=系统管理员

# ===== 授权与心跳策略 =====
# 离线宽限天数：许可证文件的离线有效期 = min(授权到期时间, 签发时间 + 本值)
OFFLINE_GRACE_DAYS=7
# 建议客户端心跳间隔（小时），客户端应在此周期内联网续期
HEARTBEAT_INTERVAL_HOURS=24
# 心跳宽限（小时）：超过该时长未心跳仅在服务端标记 stale，不影响离线验签
HEARTBEAT_STALE_HOURS=72

# ===== 会话有效期 =====
ADMIN_TOKEN_TTL_HOURS=12
CUSTOMER_TOKEN_TTL_HOURS=720

# ===== 反代 / 限流 =====
# 部署在 Nginx / Traefik 之后时设为 true，用于从 X-Forwarded-For 取真实 IP
TRUST_PROXY=false
# 每分钟单 IP 请求上限（0 表示关闭）
RATE_LIMIT_PER_MIN=600

# ===== 签名密钥（可选）=====
# 不设置则首次启动自动生成并保存在 DATA_DIR/keys.json。
# 多实例部署或迁移时请显式指定（PKCS8 PEM 的 base64，单行）。
# SIGNING_PRIVATE_KEY_B64=

# ===== 镜像版本（仅 docker-compose.yml 使用）=====
# 默认 latest：每次 GitHub Actions 构建都会更新它，`docker compose pull` 即拿到最新镜像。
# 生产环境建议锁定到具体版本号（可在 GitHub 仓库的 Packages 页面查到），例如：
# IMAGE_TAG=1.0.2
